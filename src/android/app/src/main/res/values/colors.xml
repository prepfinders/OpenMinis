<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="seed">#090C9B</color>
    <!--
      T-android-shortcut-icons-blank: foreground glyph color for the
      app-icon shortcut adaptive icons. Cream glyph on the Royal
      @color/ic_launcher_background; the values-night variant uses a
      Mist glyph on the dark night background (#141219) so the
      shortcuts stay legible in both themes. Fixed colors (not theme
      attrs) because the launcher process renders shortcut icons and
      can't resolve the app's ?attr tints.
    -->
    <color name="shortcut_icon_fg">#FBFFF1</color>
</resources>
