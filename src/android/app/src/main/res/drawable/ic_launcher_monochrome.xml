<?xml version="1.0" encoding="utf-8"?>
<!--
  T-android-themed-icons: monochrome counterpart to the Auris "Halo" mark
  (ic_launcher_foreground.png). Required for Android 13+ Themed Icons; the
  system re-tints this white silhouette with the active palette.

  Canvas is the standard adaptive-icon 108dp x 108dp. The binding clip on
  themed icons is the inscribed circle of the safe zone — center (54,54),
  radius 33 — so the mark box is s = 72dp, centred, which keeps the ring's
  outer edge at x = 84.24 (30.24 from centre) inside that circle.

  Halo geometry (fractions of s, from the design handoff): left disc of
  diameter 0.56s at x 0.08s, right ring of diameter 0.56s at x 0.36s with a
  0.10s stroke. Both shapes are drawn in one colour; the ring's hole stays
  open so the disc shows through it, as in the coloured mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- left disc: centre (43.92,54), r 20.16 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 23.76,54 a 20.16,20.16 0 1,0 40.32,0 a 20.16,20.16 0 1,0 -40.32,0 Z" />
    <!-- right ring: centre (64.08,54), mid radius 16.56, stroke 7.2 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.2"
        android:fillColor="#00000000"
        android:pathData="M 47.52,54 a 16.56,16.56 0 1,0 33.12,0 a 16.56,16.56 0 1,0 -33.12,0 Z" />
</vector>
